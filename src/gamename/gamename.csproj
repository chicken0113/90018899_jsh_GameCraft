<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="glc2dcsharp" Version="0.1.0.8" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.WinForms" Version="3.8.3" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
    <PackageReference Include="Vortice.XInput" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\resource\hot_heavy\*" Link="resource\hot_heavy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resource\sound\bgm.mp3" Link="resource\sound\bgm.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resource\sound\shot.wav" Link="resource\sound\shot.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resource\sound\enemy_hit.wav" Link="resource\sound\enemy_hit.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resource\sound\player_hit.wav" Link="resource\sound\player_hit.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resource\sound\clear.wav" Link="resource\sound\clear.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
